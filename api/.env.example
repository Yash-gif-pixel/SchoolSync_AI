# TEMPLATE ONLY -- this file IS committed to git. Never put real keys here.
# Real values go in ".env" in this same folder.

# --- Supabase (Project Settings -> API) ---
# Use the API URL (https://<project-ref>.supabase.co), NOT the dashboard URL.
SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# --- Optional: lets migrations be applied directly instead of pasting SQL ---
# Project Settings -> Database -> Connection string (URI)
DATABASE_URL=

# --- Gemini (aistudio.google.com/apikey) ---
GEMINI_API_KEY=

# Optional. Overrides the model fallback chain in
# api/app/services/document_ai.py, in order, comma separated. Google retires
# model tags on its own schedule; set this to keep the reader working without
# a code change when it happens. Must be vision-capable models.
#   GEMINI_MODELS=gemini-3.5-flash,gemini-3.6-flash,gemini-2.5-flash
GEMINI_MODELS=

# --- Deployment ---
# Browser origins allowed to call this API. Comma separated, no trailing
# slash, and never "*" — credentials are sent with every request.
# Defaults to the local Flutter dev server if unset.
#   CORS_ORIGINS=https://schoolsync.pages.dev
CORS_ORIGINS=

# Interactive API reference at /docs and /redoc. On unless set to false.
# Leave it on for a demo against seeded data; turn it off once the database
# holds real student records.
DOCS_ENABLED=true
